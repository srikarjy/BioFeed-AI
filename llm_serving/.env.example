# Copy to .env on the GPU instance before running serve.sh (or export these
# directly). Already-quantized AWQ checkpoint -- vLLM does not quantize from
# scratch here, it just loads pre-quantized weights.
VLLM_MODEL=TheBloke/Mistral-7B-Instruct-v0.2-AWQ
VLLM_PORT=8000
VLLM_GPU_MEM_UTIL=0.90
VLLM_MAX_MODEL_LEN=4096
VLLM_MAX_NUM_SEQS=32
